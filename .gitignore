# ==================== 隐私 / 密钥（禁止提交）====================
# 真实密钥只放 .env，绝不提交；只提交 .env.example 模板
.env
.env.*
!.env.example
# 其他常见密钥文件：证书 / 私钥 / 凭据
*.key
*.pem
*.p12
*.pfx
secrets.*
credentials.*
*apikey*
*api_key*
!.env.example

# ==================== Python ====================
__pycache__/
*.py[cod]
*.pyo
venv/
.venv/
*.egg-info/
dist/
build/

# ==================== Node ====================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ==================== OS 生成文件 ====================
.DS_Store
Thumbs.db
desktop.ini

# ==================== 日志 / 缓存 / 临时 ====================
logs/
*.log
*.tmp
*.temp
*.cache
*.pid
cordis.runtime.yml
# 运行期数据（股票池库 / 实验室库 / SCR 数据）现已集中存放在项目外的数据目录，
# 默认 D:\stockanaly-data，可用 .env 的 DATA_DIR 修改；下面两项为遗留与回退位置兜底
backend_fastapi/data/
backend_fastapi/chip_data/
agent_dsh/skills_library/mentor-*.skill
uvicorn.log

# ==================== 编辑器 / 本地工具配置 ====================
.vscode/
.idea/
.claude/

# ==================== 启动器生成 ====================
# 浅色 / 深色主题状态，由启动器窗口上的「主题」按钮写入，页面读取它
frontend/theme-state.js
# 编译产物（源码在 launcher/StockPoolLauncher.cs，用 csc 现编）
/*.exe
launcher/*.exe
